# ─────────────────────────────────────────────────────────────
# MoneyOS environment variables — copy to `.env` and fill in.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Option A — bundled Docker Postgres (docker compose up -d): this value works as-is.
DATABASE_URL="postgresql://moneyos:moneyos@localhost:5432/moneyos?schema=public"
# Option B — an existing local Postgres: use your own role/password, e.g.
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/moneyos?schema=public"
#   First create the database:  createdb -U postgres moneyos

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Resend transactional email (optional in dev — emails are logged if unset).
RESEND_API_KEY=""
EMAIL_FROM="MoneyOS <onboarding@resend.dev>"

# Public app URL used in emails
NEXT_PUBLIC_APP_URL="http://localhost:3000"
