# ─────────────────────────────────────────────────────────────
# Expense Manager environment variables — copy to `.env` and fill in.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Option A — bundled Docker Postgres (docker compose up -d): this value works as-is.
DATABASE_URL="postgresql://expensemanager:expensemanager@localhost:5432/expensemanager?schema=public"
# Option B — an existing local Postgres: use your own role/password, e.g.
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/expensemanager?schema=public"
#   First create the database:  createdb -U postgres expensemanager
# Production (Vercel): use a hosted Postgres (Neon / Supabase / Vercel Postgres).

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"                # prod: https://expensemanagerde.in

# Resend transactional email (optional in dev — emails are logged if unset).
RESEND_API_KEY=""
EMAIL_FROM="Expense Manager <onboarding@resend.dev>"

# Public app URL used in emails and metadata.
NEXT_PUBLIC_APP_URL="http://localhost:3000"          # prod: https://expensemanagerde.in

# Extra Server Action origins (comma-separated hosts), for tunnels or custom
# domains. Your machine's LAN IP (for phone access) is auto-detected — you only
# need this for ngrok/Cloudflare tunnels or a non-3000 port on another host.
# e.g. ALLOWED_ORIGINS="my-tunnel.ngrok-free.app,192.168.0.50:3000"
ALLOWED_ORIGINS=""
