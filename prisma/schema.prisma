// MoneyOS — Prisma schema
// Your personal financial operating system.
//
// Design notes:
// - A single `Transaction` model is the central ledger (spec §22). Expenses,
//   income, EMI payments, bills and investment contributions are all rows here,
//   discriminated by `TransactionType`. Richer domains (Investment, IPO, Loan,
//   UtilityReading, Budget, Goal, RecurringTransaction) are modeled separately
//   and can link back to the ledger.
// - Money is stored as Decimal(14,2) to avoid float rounding errors.
// - Every model carrying user data has a `userId` FK for strict data isolation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Auth (NextAuth-compatible) + user profile
// ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  onboardedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  profile    Profile?

  categories             Category[]
  paymentMethods         PaymentMethod[]
  transactions           Transaction[]
  budgets                Budget[]
  utilityReadings        UtilityReading[]
  bills                  Bill[]
  investments            Investment[]
  ipos                   Ipo[]
  loans                  Loan[]
  goals                  FinancialGoal[]
  recurringTransactions  RecurringTransaction[]
  notifications          Notification[]
  notificationPref       NotificationPreference?
  dashboardPref          DashboardPreference?
  attachments            Attachment[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  currency             String   @default("INR")
  locale               String   @default("en-IN")
  monthlyIncome        Decimal? @db.Decimal(14, 2)
  monthlyFixedExpenses Decimal? @db.Decimal(14, 2)
  currentSavings       Decimal? @db.Decimal(14, 2)
  financialYearStart   Int      @default(4) // month 1-12 (India FY starts April)
  defaultPaymentMethod String?
  phone                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// Ledger: categories, payment methods, transactions
// ─────────────────────────────────────────────────────────────

enum TransactionType {
  EXPENSE
  INCOME
  INVESTMENT
  EMI
  BILL
  TRANSFER
}

model Category {
  id        String          @id @default(cuid())
  userId    String
  name      String
  type      TransactionType @default(EXPENSE)
  icon      String?
  color     String?
  isSystem  Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  budgetCategories BudgetCategory[]

  @@unique([userId, name, type])
  @@index([userId])
}

model PaymentMethod {
  id        String   @id @default(cuid())
  userId    String
  name      String // Cash, UPI, Credit Card, Debit Card, Net Banking...
  kind      String   @default("other")
  last4     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId])
}

model Transaction {
  id              String          @id @default(cuid())
  userId          String
  type            TransactionType @default(EXPENSE)
  amount          Decimal         @db.Decimal(14, 2)
  date            DateTime
  description     String?
  merchant        String?
  notes           String?
  tags            String[]        @default([])
  source          String? // for income: Salary, Freelance, Rental...
  categoryId      String?
  paymentMethodId String?

  // Optional links back to originating domain objects
  loanId       String?
  investmentId String?
  billId       String?
  recurringId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  attachments   Attachment[]

  @@index([userId, date])
  @@index([userId, type])
  @@index([categoryId])
}

model Attachment {
  id            String   @id @default(cuid())
  userId        String
  transactionId String?
  url           String
  filename      String?
  mimeType      String?
  size          Int?
  createdAt     DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Budgeting
// ─────────────────────────────────────────────────────────────

model Budget {
  id        String   @id @default(cuid())
  userId    String
  month     Int // 1-12
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories BudgetCategory[]

  @@unique([userId, month, year])
  @@index([userId])
}

model BudgetCategory {
  id         String  @id @default(cuid())
  budgetId   String
  categoryId String
  limit      Decimal @db.Decimal(14, 2)

  budget   Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([budgetId, categoryId])
  @@index([budgetId])
}

// ─────────────────────────────────────────────────────────────
// Utilities: electricity readings + bills
// ─────────────────────────────────────────────────────────────

model UtilityReading {
  id              String   @id @default(cuid())
  userId          String
  type            String   @default("electricity") // electricity, water, gas...
  label           String? // e.g. "August 2026"
  month           Int
  year            Int
  readingDate     DateTime
  previousReading Decimal  @db.Decimal(12, 2)
  currentReading  Decimal  @db.Decimal(12, 2)
  unitsUsed       Decimal  @db.Decimal(12, 2)
  unitRate        Decimal  @db.Decimal(10, 4)
  fixedCharges    Decimal  @default(0) @db.Decimal(12, 2)
  taxes           Decimal  @default(0) @db.Decimal(12, 2)
  estimatedBill   Decimal  @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, year, month])
}

model Bill {
  id          String    @id @default(cuid())
  userId      String
  name        String
  category    String?
  amount      Decimal   @db.Decimal(14, 2)
  dueDate     DateTime
  isPaid      Boolean   @default(false)
  paidAt      DateTime?
  isRecurring Boolean   @default(false)
  frequency   String? // MONTHLY, QUARTERLY, YEARLY
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
}

// ─────────────────────────────────────────────────────────────
// Investments + IPOs
// ─────────────────────────────────────────────────────────────

enum InvestmentType {
  STOCK
  MUTUAL_FUND
  ETF
  IPO
  FIXED_DEPOSIT
  GOLD
  CRYPTO
  OTHER
}

model Investment {
  id            String         @id @default(cuid())
  userId        String
  name          String
  type          InvestmentType @default(STOCK)
  amountInvested Decimal       @db.Decimal(14, 2)
  quantity      Decimal?       @db.Decimal(18, 6)
  purchasePrice Decimal?       @db.Decimal(14, 4)
  purchaseDate  DateTime
  currentValue  Decimal?       @db.Decimal(14, 2)
  expectedReturn Decimal?      @db.Decimal(6, 2)
  platform      String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

enum IpoStatus {
  PLANNING
  APPLIED
  ALLOTTED
  NOT_ALLOTTED
  LISTED
  SOLD
}

model Ipo {
  id            String    @id @default(cuid())
  userId        String
  companyName   String
  ipoName       String?
  openDate      DateTime?
  closeDate     DateTime?
  priceBandLow  Decimal?  @db.Decimal(12, 2)
  priceBandHigh Decimal?  @db.Decimal(12, 2)
  lotSize       Int?
  lots          Int       @default(0)
  amountApplied Decimal?  @db.Decimal(14, 2)
  status        IpoStatus @default(PLANNING)
  listingDate   DateTime?
  listingPrice  Decimal?  @db.Decimal(12, 2)
  currentPrice  Decimal?  @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// ─────────────────────────────────────────────────────────────
// Loans + repayment schedule
// ─────────────────────────────────────────────────────────────

model Loan {
  id            String   @id @default(cuid())
  userId        String
  name          String
  principal     Decimal  @db.Decimal(14, 2)
  interestRate  Decimal  @db.Decimal(6, 3) // annual %
  tenureMonths  Int
  startDate     DateTime
  processingFee Decimal  @default(0) @db.Decimal(14, 2)
  emiAmount     Decimal  @db.Decimal(14, 2)
  totalInterest Decimal  @db.Decimal(14, 2)
  totalPayable  Decimal  @db.Decimal(14, 2)
  status        String   @default("ACTIVE") // PLANNED, ACTIVE, CLOSED
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments LoanPayment[]

  @@index([userId, status])
}

model LoanPayment {
  id             String    @id @default(cuid())
  loanId         String
  installmentNo  Int
  dueDate        DateTime
  principalPart  Decimal   @db.Decimal(14, 2)
  interestPart   Decimal   @db.Decimal(14, 2)
  emiAmount      Decimal   @db.Decimal(14, 2)
  balanceAfter   Decimal   @db.Decimal(14, 2)
  isPaid         Boolean   @default(false)
  paidAt         DateTime?
  extraPayment   Decimal   @default(0) @db.Decimal(14, 2)

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, installmentNo])
  @@index([loanId, dueDate])
}

// ─────────────────────────────────────────────────────────────
// Goals + recurring transactions
// ─────────────────────────────────────────────────────────────

model FinancialGoal {
  id                  String   @id @default(cuid())
  userId              String
  name                String
  targetAmount        Decimal  @db.Decimal(14, 2)
  currentAmount       Decimal  @default(0) @db.Decimal(14, 2)
  targetDate          DateTime?
  monthlyContribution Decimal? @db.Decimal(14, 2)
  icon                String?
  color               String?
  status              String   @default("ACTIVE") // ACTIVE, COMPLETED, ARCHIVED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

model RecurringTransaction {
  id            String             @id @default(cuid())
  userId        String
  type          TransactionType    @default(EXPENSE)
  name          String
  amount        Decimal            @db.Decimal(14, 2)
  categoryName  String?
  frequency     RecurringFrequency @default(MONTHLY)
  startDate     DateTime
  endDate       DateTime?
  nextRunDate   DateTime
  isActive      Boolean            @default(true)
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, nextRunDate])
}

// ─────────────────────────────────────────────────────────────
// Notifications + preferences + dashboard
// ─────────────────────────────────────────────────────────────

enum NotificationType {
  EXPENSE
  BUDGET
  BILL
  EMI
  INVESTMENT
  GOAL
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  body      String?
  href      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model NotificationPreference {
  id                 String  @id @default(cuid())
  userId             String  @unique
  emailEnabled       Boolean @default(true)
  expenseAdded       Boolean @default(false)
  largeExpenseAlert  Boolean @default(true)
  largeExpenseThreshold Decimal @default(5000) @db.Decimal(14, 2)
  budgetExceeded     Boolean @default(true)
  billReminder       Boolean @default(true)
  emiReminder        Boolean @default(true)
  investmentReminder Boolean @default(false)
  monthlySummary     Boolean @default(true)
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DashboardPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  theme         String   @default("system") // light, dark, system
  currency      String   @default("INR")
  defaultChart  String   @default("income-vs-expenses")
  hiddenWidgets String[] @default([])
  widgetOrder   String[] @default([])
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
